<Window
    x:Class="GhostDeck.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GhostDeck">

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#CC181818" Padding="12">
            <StackPanel Spacing="12">
                <TextBlock Text="GhostDeck" FontSize="24" FontWeight="SemiBold" Margin="8,8,8,16" />
                <ListBox x:Name="Nav" SelectionChanged="Nav_SelectionChanged" SelectedIndex="0">
                    <ListBoxItem Content="Dashboard" Tag="dashboard" />
                    <ListBoxItem Content="Processes" Tag="processes" />
                    <ListBoxItem Content="Power and Memory" Tag="power" />
                    <ListBoxItem Content="Network" Tag="network" />
                    <ListBoxItem Content="Cleaner" Tag="cleaner" />
                    <ListBoxItem Content="Audio" Tag="audio" />
                    <ListBoxItem Content="History" Tag="history" />
                    <ListBoxItem Content="Settings" Tag="settings" />
                </ListBox>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Padding="24">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="30" FontWeight="SemiBold" />

                    <Grid x:Name="DashboardPanel" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Padding="18" CornerRadius="12" Background="#332F2F2F">
                            <StackPanel Spacing="6">
                                <TextBlock Text="CPU" />
                                <TextBlock x:Name="CpuValue" Text="Loading..." FontSize="28" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="18" CornerRadius="12" Background="#332F2F2F">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Memory" />
                                <TextBlock x:Name="MemoryValue" Text="Loading..." FontSize="28" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="18" CornerRadius="12" Background="#332F2F2F">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Processes" />
                                <TextBlock x:Name="ProcessCountValue" Text="Loading..." FontSize="28" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="ProcessesPanel" Visibility="Collapsed" Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ProcessSearch" PlaceholderText="Search processes" TextChanged="ProcessSearch_TextChanged" />
                            <Button Grid.Column="1" Content="Refresh" Click="RefreshProcesses_Click" />
                        </Grid>
                        <ListView x:Name="ProcessList" SelectionMode="Multiple" Height="620">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProcessCountText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding CpuText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding MemoryText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding Identity}" Opacity="0.55" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Content="End selected" HorizontalAlignment="Left" Click="EndSelected_Click" />
                    </StackPanel>

                    <StackPanel x:Name="PowerPanel" Visibility="Collapsed" Spacing="12">
                        <Border Padding="12" CornerRadius="8" Background="#332F2F2F">
                            <TextBlock Text="Actions are imported from the current Ghost Mode Registry entries. Refresh does not execute them." TextWrapping="Wrap" />
                        </Border>
                        <Button Content="Refresh imported actions" HorizontalAlignment="Left" Click="RefreshPower_Click" />
                        <ListView x:Name="PowerList" Height="500">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="8" Spacing="4">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Executable}" Opacity="0.7" />
                                        <TextBlock Text="{Binding Arguments}" Opacity="0.55" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel x:Name="NetworkPanel" Visibility="Collapsed" Spacing="12">
                        <Button Content="Refresh adapters" HorizontalAlignment="Left" Click="RefreshNetwork_Click" />
                        <ListView x:Name="NetworkList" Height="540">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="8" Spacing="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Opacity="0.7" />
                                        <TextBlock Text="{Binding Summary}" Opacity="0.55" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel x:Name="CleanerPanel" Visibility="Collapsed" Spacing="12">
                        <Button Content="Scan cleanup targets" HorizontalAlignment="Left" Click="ScanCleaner_Click" />
                        <TextBlock x:Name="CleanerStatus" Text="Ready" />
                        <ListView x:Name="CleanerList" Height="540">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="8" Spacing="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Path}" Opacity="0.7" />
                                        <TextBlock Text="{Binding Summary}" Opacity="0.55" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel x:Name="AudioPanel" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="Audio output switching is not implemented yet." TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="HistoryPanel" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="Persistent action history is not implemented yet." TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="12">
                        <CheckBox Content="Use dark appearance" IsChecked="True" />
                        <CheckBox Content="Close to tray" />
                        <TextBlock Text="Process refresh interval, milliseconds" />
                        <TextBox Text="1000" Width="180" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
