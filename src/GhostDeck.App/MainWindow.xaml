<Window
    x:Class="GhostDeck.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="GhostDeck">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="Nav" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard" Icon="Home" />
                <NavigationViewItem Content="Processes" Tag="processes" Icon="AllApps" />
                <NavigationViewItem Content="Power and Memory" Tag="power" Icon="PowerButton" />
                <NavigationViewItem Content="Network" Tag="network" Icon="Globe" />
                <NavigationViewItem Content="Cleaner" Tag="cleaner" Icon="Delete" />
                <NavigationViewItem Content="Audio" Tag="audio" Icon="Volume" />
                <NavigationViewItem Content="History" Tag="history" Icon="Clock" />
            </NavigationView.MenuItems>
            <Grid Padding="24">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="PageTitle" Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}" />

                        <Grid x:Name="DashboardPanel" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel><TextBlock Text="CPU"/><TextBlock x:Name="CpuValue" Text="Loading..." FontSize="28" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel><TextBlock Text="Memory"/><TextBlock x:Name="MemoryValue" Text="Loading..." FontSize="28" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel><TextBlock Text="Processes"/><TextBlock x:Name="ProcessCountValue" Text="Loading..." FontSize="28" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel x:Name="ProcessesPanel" Visibility="Collapsed" Spacing="12">
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ProcessSearch" PlaceholderText="Search processes" TextChanged="ProcessSearch_TextChanged"/>
                                <Button Grid.Column="1" Content="Refresh" Click="RefreshProcesses_Click"/>
                            </Grid>
                            <ListView x:Name="ProcessList" SelectionMode="Multiple" Height="620">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="90"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ProcessCountText}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CpuText}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding MemoryText}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Identity}" Opacity="0.55" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Content="End selected" HorizontalAlignment="Left" Click="EndSelected_Click"/>
                        </StackPanel>

                        <StackPanel x:Name="PowerPanel" Visibility="Collapsed" Spacing="12">
                            <InfoBar IsOpen="True" Severity="Informational" Message="Actions below are imported from the current Ghost Mode registry entries. Refresh does not execute them."/>
                            <Button Content="Refresh imported actions" HorizontalAlignment="Left" Click="RefreshPower_Click"/>
                            <ListView x:Name="PowerList" Height="500">
                                <ListView.ItemTemplate><DataTemplate><StackPanel Padding="8"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Executable}" Opacity="0.7"/><TextBlock Text="{Binding Arguments}" Opacity="0.55" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel x:Name="NetworkPanel" Visibility="Collapsed" Spacing="12">
                            <Button Content="Refresh adapters" HorizontalAlignment="Left" Click="RefreshNetwork_Click"/>
                            <ListView x:Name="NetworkList" Height="540">
                                <ListView.ItemTemplate><DataTemplate><StackPanel Padding="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Opacity="0.7"/><TextBlock Text="{Binding Summary}" Opacity="0.55"/></StackPanel></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel x:Name="CleanerPanel" Visibility="Collapsed" Spacing="12">
                            <Button Content="Scan cleanup targets" HorizontalAlignment="Left" Click="ScanCleaner_Click"/>
                            <ProgressRing x:Name="CleanerProgress" IsActive="False" HorizontalAlignment="Left"/>
                            <ListView x:Name="CleanerList" Height="540">
                                <ListView.ItemTemplate><DataTemplate><StackPanel Padding="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Opacity="0.7"/><TextBlock Text="{Binding Summary}" Opacity="0.55"/></StackPanel></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel x:Name="AudioPanel" Visibility="Collapsed" Spacing="12"><InfoBar IsOpen="True" Severity="Informational" Title="Audio module scaffolded" Message="Core Audio endpoint switching is reserved for the next implementation pass."/></StackPanel>
                        <StackPanel x:Name="HistoryPanel" Visibility="Collapsed" Spacing="12"><InfoBar IsOpen="True" Severity="Informational" Title="History module scaffolded" Message="SQLite persistence is wired as a dependency and awaits the repository implementation pass."/></StackPanel>
                        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="12"><ToggleSwitch Header="Dark theme" IsOn="True"/><ToggleSwitch Header="Close to tray"/><NumberBox Header="Process refresh interval, milliseconds" Value="1000" Minimum="500" Maximum="10000"/></StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
